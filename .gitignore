# ==============================================================================
# Nexus Project .gitignore
# ==============================================================================

# Python & Virtual Environments
__pycache__/
*.py[cod]
*$py.class
*.so
.Python
env/
venv/
.venv/
ENV/
build/
develop-eggs/
dist/
downloads/
eggs/
.eggs/
lib/
lib64/
parts/
sdist/
var/
wheels/
*.egg-info/
.installed.cfg
*.egg
*.manifest
*.spec

# Node.js & Frontend
node_modules/
frontend/node_modules/
frontend/dist/
frontend/.next/
frontend/out/
npm-debug.log*
yarn-debug.log*
yarn-error.log*
.pnpm-debug.log*

# Environment Variables & Secrets (NEVER COMMIT)
.env
.env.*
!.env.example
*.pem
*.key

# Operating System & IDE Files
.DS_Store
.DS_Store?
._*
.Spotlight-V100
.Trashes
ehthumbs.db
Thumbs.db
.idea/
.vscode/
*.swp
*.swo
*~

# Local Media & Runtime Vector Storage
data/videos/*
!data/videos/.gitkeep
data/frames/*
!data/frames/.gitkeep
data/audio/*
!data/audio/.gitkeep
data/chromadb/*
!data/chromadb/.gitkeep
*.sqlite3
*.sqlite3-journal

# Testing & Code Coverage
.pytest_cache/
.coverage
.coverage.*
htmlcov/
.nox/
.tox/

# LaTeX Build Artifacts
*.aux
*.bbl
*.bcf
*.blg
*.fdb_latexmk
*.fls
*.log
*.out
*.run.xml
*.synctex.gz
*.toc
