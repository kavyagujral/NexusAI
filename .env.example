# ==============================================================================
# NEXUS SPATIOTEMPORAL RAG ENGINE - ENVIRONMENT CONFIGURATION
# ==============================================================================

# Application
APP_NAME=Nexus Spatiotemporal RAG Engine
APP_ENV=development
DEBUG=True
API_HOST=0.0.0.0
API_PORT=8000
ALLOWED_ORIGINS=http://localhost:3000,http://localhost:5173

# Relational Metadata DB (PostgreSQL / optional metadata store)
POSTGRES_USER=nexus_admin
POSTGRES_PASSWORD=nexus_secure_password
POSTGRES_DB=nexus_db
POSTGRES_HOST=localhost
POSTGRES_PORT=5432
DATABASE_URL=postgresql+asyncpg://nexus_admin:nexus_secure_password@localhost:5432/nexus_db

# ChromaDB Vector Database Configuration
CHROMA_PERSIST_DIR=./data/chromadb
CHROMA_COLLECTION_NAME=nexus_spatiotemporal_chunks

# File Storage Paths
STORAGE_DIR=./data
VIDEOS_DIR=./data/videos
FRAMES_DIR=./data/frames
AUDIO_DIR=./data/audio

# Video Processing Configurations
FRAME_SAMPLE_INTERVAL_SECONDS=2.0
MAX_UPLOAD_SIZE_MB=500
ALLOWED_VIDEO_EXTENSIONS=.mp4,.mkv,.mov,.avi,.webm

# ML Models & Device
DEVICE=auto
WHISPER_MODEL=base
VISION_MODEL_BACKBONE=resnet50
TEXT_EMBED_MODEL=sentence-transformers/all-MiniLM-L6-v2
GRU_HIDDEN_DIM=256
GRU_BIDIRECTIONAL=True
EMBEDDING_DIM=512
